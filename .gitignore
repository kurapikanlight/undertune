/Undertune-Flutter-Handoff/
*.zip

# Upstream checkout is restored by scripts/setup-backend.sh from the exact
# repository/revision in vendor/pipepipe.lock.json. Keep that pin and scripts,
# not another repository's Git history, caches or generated build outputs.
/vendor/PipePipeExtractor/
/vendor/.pipepipe-update.lock

# Local development evidence and planning; keep README, DEVELOPMENT and branding
